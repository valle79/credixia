# Connection string de Neon (con pooler para mejor performance)
ConnectionStrings__Postgres=postgresql://neondb_owner:npg_TNaLm8rZYt3j@ep-floral-rice-b5hpfjuk-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 SEGURIDAD - JWT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ⚠️ GENERAR UNA NUEVA CON: .\scripts\generate-jwt-secret.ps1
# Debe tener mínimo 32 caracteres
Jwt__SigningKey=REEMPLAZAR_CON_CLAVE_GENERADA_POR_SCRIPT

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 FRONTEND - URLs permitidas
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# URL del frontend en Netlify (actualizar después de crear el sitio)
Auth__PublicUrl=https://tu-app.netlify.app

# CORS - Permitir frontend de Netlify
Cors__AllowedOrigins__0=https://tu-app.netlify.app

# Si tienes dominio personalizado, agregarlo también:
# Cors__AllowedOrigins__1=https://app.credixia.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚀 MIGRACIONES Y BOOTSTRAP
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ejecutar migraciones automáticamente en el primer deploy
Database__MigrateOnStartup=true

# Usuario administrador inicial (cambiar password después del primer login)
Bootstrap__Email=admin@credixia.com
Bootstrap__Password=Credixia2024!
Bootstrap__FullName=Administrador Sistema

